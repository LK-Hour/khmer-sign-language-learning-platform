# Backend environment example for Khmer Sign Language Platform

# Database Configuration
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/khmer_sign_db

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_random_string_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# FastAPI Environment
ENVIRONMENT=development
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# OAuth Configuration (replace with your own credentials)
GOOGLE_CLIENT_ID=your-google-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend redirect target after Telegram auth
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://delicious-folk-recount.ngrok-free.dev,https://delicious-folk-recount.ngrok-free.dev
